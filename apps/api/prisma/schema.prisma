generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// What kind of account this is, fixed at signup. Admin accounts can only be
// created with a platform admin invite code.
enum AccountType {
  ADMIN
  TEACHER
}

// Role within one school.
enum Role {
  ADMIN
  TEACHER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum AnnouncementCategory {
  GENERAL
  ACADEMIC
  EVENT
  URGENT
}

model User {
  id                String      @id @default(uuid())
  email             String      @unique // stored lower-cased
  passwordHash      String
  fullName          String
  accountType       AccountType
  department        String?
  employeeId        String?
  emailVerified     Boolean     @default(false)
  adminInviteCodeId String? // which admin invite code created this account
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  adminInviteCode    AdminInviteCode?         @relation(fields: [adminInviteCodeId], references: [id], onDelete: SetNull)
  memberships        SchoolMembership[]
  sessions           Session[]
  verificationTokens EmailVerificationToken[]
  schoolsCreated     School[]                 @relation("SchoolCreator")
  announcements      Announcement[]
}

// Opaque login sessions. Only a SHA-256 hash of the cookie token is stored,
// so a database leak does not expose usable sessions.
model Session {
  id             String   @id @default(uuid())
  userId         String
  tokenHash      String   @unique
  activeSchoolId String? // school the user is currently working in
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  userAgent      String?
  ip             String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Issued by the platform owner (`pnpm --filter api invite:create`). Required
// to sign up as an admin. May be single-use or shared, and can expire.
model AdminInviteCode {
  id        String    @id @default(uuid())
  code      String    @unique // stored upper-cased
  note      String?
  maxUses   Int? // null = unlimited
  uses      Int       @default(0)
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  users User[]
}

model School {
  id            String    @id @default(uuid())
  name          String
  // Unique per school; shared with staff so they can join.
  inviteCode    String    @unique
  board         String
  classes       String[]  @default([]) // e.g. ["6th", "7th", …], in display order
  mouStartDate  DateTime? @db.Date
  mouEndDate    DateTime? @db.Date
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstNumber     String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy     User?              @relation("SchoolCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships   SchoolMembership[]
  programs      Program[]
  announcements Announcement[]
}

// Role lives on the membership, not the user: an admin can belong to many
// schools, a teacher to one active school at a time.
model SchoolMembership {
  id        String           @id @default(uuid())
  userId    String
  schoolId  String
  role      Role
  status    MembershipStatus @default(PENDING)
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([schoolId])
}

// Programs such as JEE or NEET. Batches will be created under these.
model Program {
  id         String   @id @default(uuid())
  schoolId   String
  name       String
  isStandard Boolean // one of the platform's standard programs vs. added by the school
  sortOrder  Int
  createdAt  DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Announcement {
  id          String               @id @default(uuid())
  schoolId    String
  category    AnnouncementCategory @default(GENERAL)
  title       String
  body        String?
  createdById String?
  createdAt   DateTime             @default(now())

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
}
