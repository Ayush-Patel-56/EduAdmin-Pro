generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// What kind of account this is, fixed at signup. Admin accounts can only be
// created with a platform admin invite code.
enum AccountType {
  ADMIN
  TEACHER
}

// Role within one school.
enum Role {
  ADMIN
  TEACHER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REVOKED // removed by an admin; cannot rejoin with the invite code
  LEFT // teacher switched to another school; may rejoin later
}

// Accent colour a user picks in Account Preferences; null = the portal default.
enum AccentTheme {
  INDIGO
  BLUE
  EMERALD
  SLATE
}

enum ProgramType {
  JEE
  NEET
  FOUNDATIONAL
  OTHER
}

enum ThemeColor {
  BLUE
  GREEN
  PURPLE
}

enum FacultyStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

// A teacher's role within one batch.
enum BatchRole {
  PRIMARY
  SUBSTITUTE
  ASSISTANT
}

enum SyllabusStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PromotionStatus {
  CONFIRMED
  DISMISSED
}

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
}

// Hiring pipeline (PRD §4.4). REJECTED sits outside the board's six columns.
enum CandidateStage {
  APPLIED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  UNDER_REVIEW
  OFFER_EXTENDED
  HIRED
  REJECTED
}

enum InterviewMode {
  IN_PERSON
  ONLINE
}

enum InterviewResult {
  PENDING
  PASS_SHORTLISTED
  OFFER_RECOMMENDED
  ON_HOLD
  FAIL_REJECTED
}

enum AppraisalPeriod {
  ANNUAL
  MID_TERM
  PROBATION_REVIEW
}

enum AppraisalStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum AppraisalBadge {
  EXCELLENT
  GOOD
  SATISFACTORY
  NEEDS_IMPROVEMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  COMPLETED
}

// What an uploaded file is for; decides who may upload and read it, and which
// types and sizes are accepted.
enum FilePurpose {
  STUDENT_PHOTO
  FACULTY_PHOTO
  STUDY_MATERIAL
  ASSIGNMENT_SHEET // the question paper of an assignment
  SUBMISSION // a student's work, uploaded by their teacher
}

// The role switch on a faculty profile (PRD 4.7). A label only: it grants no extra access.
enum FacultyDesignation {
  TEACHER
  COORDINATOR
}

enum MaterialType {
  NOTES
  PDF
  VIDEO
  PRACTICE_SHEET
  DPP
  REFERENCE
  ANSWER_KEY
}

enum AssignmentType {
  HOMEWORK
  DPP
  WORKSHEET
  PROJECT
  REVISION
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
}

enum CounselingType {
  ACADEMIC
  CAREER
  PERSONAL
  DISCIPLINARY
  PARENT_MEETING
}

enum CounselingStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum FileStatus {
  PENDING // upload URL issued, bytes not confirmed yet
  READY // size and file signature checked
}

enum AnnouncementCategory {
  GENERAL
  ACADEMIC
  EVENT
  URGENT
}

// Email uniqueness is enforced case-insensitively by a unique expression index,
// "User_email_lower_key" ON lower("email"), created in migration
// 20261011210000. Prisma can't express expression indexes in this file, but it
// also leaves them alone: `prisma migrate diff` does not try to drop it.
model User {
  id                 String       @id @default(uuid())
  email              String       @unique // stored lower-cased
  passwordHash       String
  fullName           String
  accountType        AccountType
  department         String?
  employeeId         String?
  emailVerified      Boolean      @default(false)
  adminInviteCodeId  String? // which admin invite code created this account
  // Account Preferences
  emailNotifications Boolean      @default(true) // report digest emails
  syllabusUpdates    Boolean      @default(true) // syllabus coverage alerts
  accentTheme        AccentTheme?
  avatarUrl          String? // a profile picture hosted online (https); an uploaded one (UserAvatar) takes precedence
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)

  adminInviteCode    AdminInviteCode?         @relation(fields: [adminInviteCodeId], references: [id], onDelete: SetNull)
  memberships        SchoolMembership[]
  sessions           Session[]
  verificationTokens EmailVerificationToken[]
  schoolsCreated     School[]                 @relation("SchoolCreator")
  announcements      Announcement[]
  facultyProfiles    Faculty[]
  counselingSessions CounselingSession[]
  markedOccurrences  ClassOccurrence[]
  avatar             UserAvatar?
  notifications      Notification[]
  emailDigests       EmailDigest[]
}

// Opaque login sessions. Only a SHA-256 hash of the cookie token is stored,
// so a database leak does not expose usable sessions.
model Session {
  id             String   @id @default(uuid())
  userId         String
  tokenHash      String   @unique
  activeSchoolId String? // school the user is currently working in
  expiresAt      DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  userAgent      String?
  ip             String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One-time 6-digit email verification code. Only a hash is stored, keyed to
// the user, and a code is locked after too many wrong attempts.
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Issued by the platform owner (`pnpm --filter api invite:create`). Required
// to sign up as an admin. May be single-use or shared, and can expire.
model AdminInviteCode {
  id        String    @id @default(uuid())
  code      String    @unique // stored upper-cased
  note      String?
  maxUses   Int? // null = unlimited
  uses      Int       @default(0)
  expiresAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  users User[]
}

model School {
  id                     String    @id @default(uuid())
  name                   String
  // Unique per school; shared with staff so they can join.
  inviteCode             String    @unique
  // Shared only with other admins. Entering it joins as ADMIN; the teacher
  // inviteCode above can never grant admin rights.
  adminInviteCode        String    @unique @default(dbgenerated("generate_school_invite_code()"))
  board                  String
  classes                String[]  @default([]) // e.g. ["6th", "7th", …], in display order
  academicYearStartMonth Int       @default(4) // 1-12; April by default
  mouStartDate           DateTime? @db.Date
  mouEndDate             DateTime? @db.Date
  contactPerson          String?
  phone                  String?
  email                  String?
  address                String?
  gstNumber              String?
  createdById            String?
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)

  createdBy       User?               @relation("SchoolCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships     SchoolMembership[]
  programs        Program[]
  batches         Batch[]
  faculty         Faculty[]
  syllabusItems   SyllabusItem[]
  promotionCycles PromotionCycle[]
  chapters        CurriculumChapter[]
  concepts        CurriculumConcept[]
  requirements    JobRequirement[]
  candidates      Candidate[]
  interviews      Interview[]
  appraisals      TeacherAppraisal[]
  announcements   Announcement[]
  students        Student[]
  files           FileObject[]
  materials       StudyMaterial[]
  assignments     Assignment[]
  counseling      CounselingSession[]
  scheduleSlots   ScheduleSlot[]
  specialClasses  SpecialClass[]
  occurrences     ClassOccurrence[]
  attendance      AttendanceRecord[]
  feeStructures   FeeStructure[]
  feeDues         FeeDue[]
  feePayments     FeePayment[]
  receiptCounters FeeReceiptCounter[]
  meetings        Meeting[]
  agendaItems     MeetingAgendaItem[]
  calendarEvents  CalendarEvent[]
  dailyReports    DailyReport[]
  feedback        Feedback[]
  ptmNotes        PtmNote[]
  questions       Question[]
  tests           Test[]
  testQuestions   TestQuestion[]
  testResults     TestResult[]
  testAnswers     TestAnswer[]
  dailyRatings    DailyRating[]
  studentMarks    StudentMark[]
  progressReports ProgressReport[]
  notifications   Notification[]
}

// Role lives on the membership, not the user: an admin can belong to many
// schools, a teacher to one active school at a time.
model SchoolMembership {
  id        String           @id @default(uuid())
  userId    String
  schoolId  String
  role      Role
  status    MembershipStatus @default(PENDING)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([schoolId])
}

// Programs such as JEE or NEET. Every batch belongs to exactly one program.
model Program {
  id            String      @id @default(uuid())
  schoolId      String
  name          String // display name, unique per school (case-insensitive in the service)
  code          String? // e.g. "JEE-2Y", unique per school when set; stored upper-cased
  type          ProgramType @default(OTHER)
  targetExams   String[]    @default([])
  durationYears Int?
  themeColor    ThemeColor  @default(BLUE)
  isActive      Boolean     @default(true)
  isStandard    Boolean // one of the platform's standard programs vs. added by the school
  sortOrder     Int
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  batches         Batch[]
  facultyPrograms FacultyProgram[]
  chapters        CurriculumChapter[]
  students        Student[]
  feeStructures   FeeStructure[]
  calendarEvents  CalendarEvent[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  // Lets batches reference (program, school) so a batch can never point at
  // another school's program.
  @@unique([id, schoolId])
  @@index([schoolId])
}

// A student group for one academic period, always under a program.
model Batch {
  id            String    @id @default(uuid())
  schoolId      String
  programId     String
  name          String
  classLevel    Int? // 6-12
  capacity      Int       @default(60)
  startDate     DateTime  @db.Date
  endDate       DateTime? @db.Date
  coordinatorId String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // NoAction (checked at end of statement) so deleting a school can cascade
  // through programs and batches together; the service blocks deleting a
  // program that still has batches.
  program        Program             @relation(fields: [programId, schoolId], references: [id, schoolId], onDelete: NoAction)
  coordinator    Faculty?            @relation("BatchCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  facultyBatches FacultyBatch[]
  syllabusItems  SyllabusItem[]
  students       Student[]
  enrollments    StudentEnrollment[]
  materials      StudyMaterial[]
  assignments    Assignment[]
  scheduleSlots  ScheduleSlot[]
  specialClasses SpecialClass[]
  occurrences    ClassOccurrence[]
  feeStructures  FeeStructure[]
  calendarEvents CalendarEvent[]
  dailyReports   DailyReport[]
  ptmNotes       PtmNote[]
  tests          Test[]
  dailyRatings   DailyRating[]
  studentMarks   StudentMark[]

  @@unique([programId, name])
  @@unique([id, schoolId])
  @@index([schoolId])
}

// A teacher's profile in one school. Imported faculty exist before they have a
// login; `userId` links the record once that teacher joins the school.
model Faculty {
  id              String             @id @default(uuid())
  schoolId        String
  userId          String?
  name            String
  email           String? // lower-cased
  phone           String?
  altPhone        String?
  employeeId      String?
  dateOfBirth     DateTime?          @db.Date
  gender          String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  subjects        String[]           @default([])
  specialization  String?
  qualification   String?
  experienceYears Int?
  joiningDate     DateTime?          @db.Date
  status          FacultyStatus      @default(ACTIVE)
  bio             String?
  profileImageUrl String?
  photoFileId     String?            @unique // an uploaded photo (takes precedence over the link)
  designation     FacultyDesignation @default(TEACHER)
  primarySubject  String? // one of `subjects`, starred on the profile
  primaryStream   String? // e.g. Science, Commerce
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  batchAssignments   FacultyBatch[]
  programAssignments FacultyProgram[]
  coordinatedBatches Batch[]             @relation("BatchCoordinator")
  appraisals         TeacherAppraisal[]
  candidate          Candidate?
  photo              FileObject?         @relation("FacultyPhoto", fields: [photoFileId, schoolId], references: [id, schoolId], onDelete: NoAction)
  materials          StudyMaterial[]
  assignments        Assignment[]
  counselingSessions CounselingSession[]
  scheduleSlots      ScheduleSlot[]
  specialClasses     SpecialClass[]
  occurrences        ClassOccurrence[]
  dailyReports       DailyReport[]
  feedbackSent       Feedback[]          @relation("FeedbackSender")
  feedbackReceived   Feedback[]          @relation("FeedbackTarget")
  ptmNotes           PtmNote[]
  questions          Question[]
  tests              Test[]
  dailyRatings       DailyRating[]

  @@unique([schoolId, userId])
  @@unique([schoolId, email])
  @@unique([schoolId, employeeId])
  @@unique([id, schoolId])
  @@index([schoolId])
}

// Faculty <-> batch, with the teacher's role in that batch.
model FacultyBatch {
  facultyId String
  batchId   String
  schoolId  String
  role      BatchRole @default(PRIMARY)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  faculty Faculty @relation(fields: [facultyId, schoolId], references: [id, schoolId], onDelete: Cascade)
  batch   Batch   @relation(fields: [batchId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@id([facultyId, batchId])
  @@index([batchId])
}

// Faculty <-> program. Assigning a batch also assigns its program.
model FacultyProgram {
  facultyId String
  programId String
  schoolId  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  faculty Faculty @relation(fields: [facultyId, schoolId], references: [id, schoolId], onDelete: Cascade)
  program Program @relation(fields: [programId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@id([facultyId, programId])
  @@index([programId])
}

// One chapter on a batch's syllabus for one subject. Admin and faculty edit
// the same rows, so both portals always see the same status.
model SyllabusItem {
  id             String         @id @default(uuid())
  schoolId       String
  batchId        String
  subject        String
  title          String
  estimatedHours Int?
  targetDates    String? // free text, e.g. "Oct 01 - Oct 15"
  status         SyllabusStatus @default(NOT_STARTED)
  remarks        String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  batch  Batch  @relation(fields: [batchId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([schoolId, batchId, subject])
}

// The yearly class promotion decision. One row per school and academic year,
// so a year can never be promoted twice.
model PromotionCycle {
  id           String          @id @default(uuid())
  schoolId     String
  academicYear String // "2026-2027"
  boundaryDate DateTime        @db.Date
  status       PromotionStatus
  studentCount Int             @default(0)
  decidedById  String?
  decidedAt    DateTime        @default(now()) @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, academicYear])
}

model Announcement {
  id          String               @id @default(uuid())
  schoolId    String
  category    AnnouncementCategory @default(GENERAL)
  title       String
  body        String?
  createdById String?
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
}

// The school's curriculum: Subject -> Chapter -> Concept. It is the reference
// taxonomy (board, class, program) that question banks and tests pick from.
// Names are unique by expression indexes that Prisma can't express (it leaves
// them alone): "CurriculumConcept_chapterId_lower_name_key" and
// "CurriculumChapter_natural_key", both from migration 20261012030000.
model CurriculumChapter {
  id            String   @id @default(uuid())
  schoolId      String
  programId     String? // optional; must be a program of the same school
  subject       String
  name          String
  code          String? // e.g. "PHY-11-CH03", unique per school; stored upper-cased
  board         String? // CBSE / ICSE / ISC / State Board
  classLevel    String? // one of the school's classes, e.g. "11th"
  expectedHours Int?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // NoAction (checked at end of statement) lets a school delete cascade; the
  // programs service unlinks chapters before deleting a single program.
  program     Program?            @relation(fields: [programId, schoolId], references: [id, schoolId], onDelete: NoAction)
  concepts    CurriculumConcept[]
  questions   Question[]
  assignments Assignment[]

  @@unique([schoolId, code])
  @@unique([id, schoolId])
  @@index([schoolId, subject])
  @@index([programId])
}

model CurriculumConcept {
  id        String   @id @default(uuid())
  schoolId  String
  chapterId String
  name      String
  code      String? // e.g. "PHY-11-CH03-CP02", unique per school; stored upper-cased
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  school  School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  chapter CurriculumChapter @relation(fields: [chapterId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([schoolId, code])
  @@index([chapterId])
}

// An open teaching position.
model JobRequirement {
  id            String    @id @default(uuid())
  schoolId      String
  title         String
  subject       String // subject or program the role teaches
  department    String // Science / Mathematics / English / Humanities / Commerce
  vacancies     Int       @default(1)
  status        JobStatus @default(OPEN)
  experience    String? // e.g. "3+ years"
  qualification String?
  postingDate   DateTime? @db.Date
  closingDate   DateTime? @db.Date
  createdById   String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
}

model Candidate {
  id                  String         @id @default(uuid())
  schoolId            String
  fullName            String
  roleApplied         String
  email               String? // lower-cased
  phone               String?
  department          String?
  experienceYears     Int?
  stage               CandidateStage @default(APPLIED)
  qualification       String?
  currentOrganization String?
  expectedSalary      Int? // rupees per year
  resumeUrl           String?
  stageChangedAt      DateTime       @default(now()) @db.Timestamptz(3)
  hiredAt             DateTime?      @db.Timestamptz(3)
  // The faculty profile created when this candidate was hired; it stops a
  // second hire (or hire -> reject -> hire) from onboarding them twice. A plain
  // FK, not composite, so deleting the profile can clear it; the profile is
  // always created in the candidate's own school.
  facultyId           String?        @unique
  createdById         String?
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  faculty    Faculty?    @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  interviews Interview[]

  @@unique([id, schoolId])
  @@index([schoolId, stage])
}

model Interview {
  id          String          @id @default(uuid())
  schoolId    String
  candidateId String
  scheduledAt DateTime        @db.Timestamptz(3)
  mode        InterviewMode   @default(IN_PERSON)
  location    String? // room or meeting link
  panel       String? // interviewer names
  rating      Int? // 1 (Poor) - 5 (Exceptional)
  result      InterviewResult @default(PENDING)
  feedback    String?
  createdById String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([schoolId, scheduledAt])
  @@index([candidateId])
}

model TeacherAppraisal {
  id               String          @id @default(uuid())
  schoolId         String
  facultyId        String
  department       String?
  period           AppraisalPeriod @default(ANNUAL)
  academicYear     String // "2026-2027"
  status           AppraisalStatus @default(PENDING)
  teachingScore    Int? // 1-5
  punctualityScore Int? // 1-5
  studentAvg       Decimal?        @db.Decimal(5, 2) // filled from test results once they exist
  overallBadge     AppraisalBadge?
  remarks          String? // remarks & goals
  improvementAreas String?
  appraiserId      String?
  appraiserName    String?
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([facultyId, period, academicYear])
  @@index([schoolId, status])
}

// Append-only record of every recruitment and appraisal change. There is
// deliberately no foreign key to School: the trail outlives deleted records
// and schools. A database trigger (see migration) rejects UPDATE and DELETE.
model RecruitmentAuditLog {
  id        String      @id @default(uuid())
  schoolId  String
  action    AuditAction
  entity    String // table name, e.g. "Candidate"
  recordId  String
  summary   String // human-readable, e.g. "Stage Applied -> Shortlisted"
  changes   Json? // { field: [before, after] } for updates, the row for create/delete
  actorId   String?
  actorName String
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  @@index([schoolId, createdAt])
}

// A student of one school (PRD 4.6). `batchId` is the current batch (its
// program is `programId`); StudentEnrollment keeps the batch history.
// Admission number and Aadhaar are unique within a school, roll number within
// a batch. Faculty read a limited view; only admins create or edit.
model Student {
  id                 String        @id @default(uuid())
  schoolId           String
  fullName           String
  admissionNumber    String? // stored upper-cased
  aadharNumber       String? // 12 digits, stored without spaces or dashes
  rollNumber         String? // stored upper-cased (unique per batch)
  email              String? // lower-cased
  phone              String? // 10-digit mobile
  parentContact      String? // 10-digit mobile
  address            String?
  city               String?
  state              String?
  pincode            String?
  dateOfBirth        DateTime?     @db.Date
  gender             String? // Male / Female / Other
  bloodGroup         String?
  profileImageUrl    String? // an external https image
  photoFileId        String?       @unique // or an uploaded photo (takes precedence)
  previousSchool     String?
  previousPercentage Decimal?      @db.Decimal(5, 2)
  classLevel         String? // one of the school's classes, e.g. "9th"
  programId          String?
  batchId            String?
  admissionDate      DateTime?     @db.Date
  status             StudentStatus @default(ACTIVE)
  notes              String?
  createdById        String?
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)

  school      School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // NoAction (checked at end of statement) so a school delete cascades; the
  // batch and program services unassign students before deleting either.
  program     Program?               @relation(fields: [programId, schoolId], references: [id, schoolId], onDelete: NoAction)
  batch       Batch?                 @relation(fields: [batchId, schoolId], references: [id, schoolId], onDelete: NoAction)
  photo       FileObject?            @relation(fields: [photoFileId, schoolId], references: [id, schoolId], onDelete: NoAction)
  guardians   StudentGuardian[]
  enrollments StudentEnrollment[]
  submissions AssignmentSubmission[]
  counseling  CounselingSession[]
  attendance  AttendanceRecord[]
  feeDues     FeeDue[]
  ptmNotes    PtmNote[]
  testResults TestResult[]
  ratings     DailyRating[]
  marks       StudentMark[]
  reports     ProgressReport[]

  @@unique([schoolId, admissionNumber])
  @@unique([schoolId, aadharNumber])
  @@unique([batchId, rollNumber])
  @@unique([id, schoolId])
  @@index([schoolId, classLevel])
  @@index([programId])
}

// Parents and guardians. At most one primary contact per student (partial
// unique index "StudentGuardian_primary_key" in the migration).
model StudentGuardian {
  id           String   @id @default(uuid())
  schoolId     String
  studentId    String
  name         String
  relationship String?
  phone        String?
  altPhone     String?
  email        String?
  occupation   String?
  annualIncome Int? // rupees per year
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  student Student @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([studentId])
}

// Batch history: one open row (endedOn null) for the current batch, closed
// when the student moves or is unassigned. The batch and program names are
// kept, so the history still reads right after a batch is deleted (batchId
// is then cleared). A plain FK (not composite) so the delete can clear it;
// rows are only ever written for a batch of the student's own school.
model StudentEnrollment {
  id          String    @id @default(uuid())
  schoolId    String
  studentId   String
  batchId     String?
  batchName   String
  programName String
  rollNumber  String?
  enrolledOn  DateTime  @db.Date
  endedOn     DateTime? @db.Date
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  student Student @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([batchId])
}

// Metadata of a file whose bytes live in private object storage (Cloudflare
// R2, or a local folder in development). Bytes are written straight to
// storage with a short-lived signed URL, then checked (size, file signature)
// before the file is READY; downloads also use short-lived signed URLs.
model FileObject {
  id           String      @id @default(uuid())
  schoolId     String
  purpose      FilePurpose
  status       FileStatus  @default(PENDING)
  key          String      @unique // opaque storage key
  originalName String
  contentType  String
  size         Int // bytes
  uploadedById String?
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)

  school      School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students    Student[]
  faculty     Faculty[]              @relation("FacultyPhoto")
  materials   StudyMaterial[]
  assignments Assignment[]
  submissions AssignmentSubmission[]

  @@unique([id, schoolId])
  @@index([schoolId, status, createdAt])
}

// Study material uploaded by a teacher for one of their batches (PRD 5.9).
// Public material is visible to every teacher of the batch; private only to
// its uploader. Admins see all of it.
model StudyMaterial {
  id          String       @id @default(uuid())
  schoolId    String
  batchId     String
  subject     String
  title       String
  description String?
  provider    String // who made it, e.g. "Faculty Study Team"
  chapter     String? // chapter / topic
  type        MaterialType
  isPublic    Boolean      @default(true)
  fileId      String       @unique // one record per uploaded file
  facultyId   String? // the uploading teacher; null once their profile is deleted
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  batch   Batch      @relation(fields: [batchId, schoolId], references: [id, schoolId], onDelete: Cascade)
  file    FileObject @relation(fields: [fileId, schoolId], references: [id, schoolId], onDelete: NoAction)
  faculty Faculty?   @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([batchId])
}

// An assignment or DPP for one batch. Students have no portal, so their
// submissions are recorded (and graded) by staff (HLD 9.9).
model Assignment {
  id             String         @id @default(uuid())
  schoolId       String
  batchId        String
  subject        String
  title          String
  description    String?
  chapter        String // chapter / topic as entered (or the curriculum chapter's name when picked)
  chapterId      String? // a curriculum chapter of the school; null once it is deleted
  topic          String? // the concept / topic: matched with question topics for topic strength
  type           AssignmentType
  dueAt          DateTime       @db.Timestamptz(3) // due date + time, entered in IST
  totalMarks     Int
  questionFileId String?        @unique
  facultyId      String? // the teacher who set it
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  school       School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  batch        Batch                  @relation(fields: [batchId, schoolId], references: [id, schoolId], onDelete: Cascade)
  questionFile FileObject?            @relation(fields: [questionFileId, schoolId], references: [id, schoolId], onDelete: NoAction)
  faculty      Faculty?               @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  // School-tied: deleting the chapter nulls only chapterId (ON DELETE SET NULL ("chapterId") in the migration).
  curriculum   CurriculumChapter?     @relation(fields: [chapterId, schoolId], references: [id, schoolId], onDelete: SetNull)
  submissions  AssignmentSubmission[]

  @@unique([id, schoolId])
  @@index([schoolId, dueAt])
  @@index([batchId])
  @@index([chapterId])
}

// One student's work on one assignment, entered by a teacher.
model AssignmentSubmission {
  id           String           @id @default(uuid())
  schoolId     String
  assignmentId String
  studentId    String
  status       SubmissionStatus @default(PENDING)
  score        Decimal?         @db.Decimal(6, 2)
  feedback     String?
  fileId       String?          @unique
  submittedOn  DateTime?        @db.Date
  gradedAt     DateTime?        @db.Timestamptz(3)
  gradedById   String? // user id
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  assignment Assignment  @relation(fields: [assignmentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  student    Student     @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  file       FileObject? @relation(fields: [fileId, schoolId], references: [id, schoolId], onDelete: NoAction)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

// A counseling session (PRD 4.13 / 5.14). The counselor is an admin (a user)
// or a faculty member; their name is kept so the record still reads right
// after they leave.
model CounselingSession {
  id                 String           @id @default(uuid())
  schoolId           String
  studentId          String
  counselorUserId    String?
  counselorFacultyId String?
  counselorName      String
  type               CounselingType
  status             CounselingStatus @default(SCHEDULED)
  scheduledAt        DateTime         @db.Timestamptz(3)
  durationMinutes    Int              @default(30)
  nextSessionDate    DateTime?        @db.Date
  notes              String?
  actionItems        String?
  flagged            Boolean          @default(false)
  createdById        String?
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          Student  @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  counselorUser    User?    @relation(fields: [counselorUserId], references: [id], onDelete: SetNull)
  counselorFaculty Faculty? @relation(fields: [counselorFacultyId], references: [id], onDelete: SetNull)

  @@index([schoolId, scheduledAt])
  @@index([studentId])
  @@index([counselorFacultyId])
}

enum SpecialClassType {
  EXTRA
  DOUBT
  REVISION
  MAKEUP
  ORIENTATION
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// A weekly recurring class (PRD 4.1 / 5.2). Times are minutes after midnight,
// Indian time; the day is 0 (Sunday) to 6. Checks in the migration keep the
// day, the times (end after start) and the effective period valid.
model ScheduleSlot {
  id            String    @id @default(uuid())
  schoolId      String
  facultyId     String
  batchId       String
  subject       String
  dayOfWeek     Int
  startMinute   Int
  endMinute     Int
  room          String?
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  active        Boolean   @default(true)
  createdById   String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  faculty     Faculty           @relation(fields: [facultyId, schoolId], references: [id, schoolId], onDelete: Cascade)
  batch       Batch             @relation(fields: [batchId, schoolId], references: [id, schoolId], onDelete: Cascade)
  occurrences ClassOccurrence[]

  @@unique([id, schoolId])
  @@index([schoolId, dayOfWeek])
  @@index([facultyId])
  @@index([batchId])
}

// A one-off class (Extra, Doubt, Revision, Makeup, Orientation) on one date.
model SpecialClass {
  id          String           @id @default(uuid())
  schoolId    String
  title       String
  type        SpecialClassType @default(EXTRA)
  subject     String?
  batchId     String
  // Optional: an admin may schedule it before a teacher is chosen. Then any
  // teacher of the batch can take its attendance.
  facultyId   String?
  date        DateTime         @db.Date
  startMinute Int
  endMinute   Int
  room        String?
  notes       String?
  createdById String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  batch       Batch             @relation(fields: [batchId, schoolId], references: [id, schoolId], onDelete: Cascade)
  faculty     Faculty?          @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  occurrences ClassOccurrence[]

  @@unique([id, schoolId])
  @@index([schoolId, date])
  @@index([batchId])
  @@index([facultyId])
}

// One class on one date: the attendance sheet. It keeps what the class was
// (title, times, room, batch), so attendance history reads the same after the
// slot or special class is edited or deleted. A batch with occurrences can't
// be deleted (NoAction; the batch service explains why).
model ClassOccurrence {
  id             String            @id @default(uuid())
  schoolId       String
  date           DateTime          @db.Date
  batchId        String
  slotId         String?
  specialClassId String?
  facultyId      String?
  title          String
  subject        String?
  type           SpecialClassType? // null for a weekly slot
  startMinute    Int
  endMinute      Int
  room           String?
  markedById     String?
  submittedAt    DateTime          @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  batch        Batch              @relation(fields: [batchId, schoolId], references: [id, schoolId], onDelete: NoAction)
  slot         ScheduleSlot?      @relation(fields: [slotId], references: [id], onDelete: SetNull)
  specialClass SpecialClass?      @relation(fields: [specialClassId], references: [id], onDelete: SetNull)
  faculty      Faculty?           @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  markedBy     User?              @relation(fields: [markedById], references: [id], onDelete: SetNull)
  records      AttendanceRecord[]

  @@unique([slotId, date])
  @@unique([specialClassId])
  @@unique([id, schoolId])
  @@index([schoolId, date])
  @@index([batchId, date])
}

// One student's status in one class occurrence.
model AttendanceRecord {
  id           String           @id @default(uuid())
  schoolId     String
  occurrenceId String
  studentId    String
  status       AttendanceStatus
  note         String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  occurrence ClassOccurrence @relation(fields: [occurrenceId, schoolId], references: [id, schoolId], onDelete: Cascade)
  // NoAction (checked at end of statement): deleting a school still cascades,
  // but a student with attendance can't be deleted (the service says why).
  student    Student         @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: NoAction)

  @@unique([occurrenceId, studentId])
  @@index([studentId])
  @@index([schoolId])
}

enum FeeCategory {
  REGISTRATION
  MONTHLY_TUITION
  EXAM
  MATERIAL
  OTHER
}

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  YEARLY
}

/// Paid / Pending / Partial / Overdue come from the amounts and due date; an
/// admin can override (with a reason) and Waived exists only as an override.
enum FeeStatus {
  PAID
  PENDING
  PARTIAL
  OVERDUE
  WAIVED
}

enum PaymentMethod {
  UPI
  CASH
  CARD
  NET_BANKING
  CHEQUE
  DD
}

enum PaymentSource {
  MANUAL
  IMPORT
}

// A fee the school charges (PRD 4.9). Amounts are whole paise, never floats.
// Program/batch narrow who it applies to (null = every program / batch).
// One name per school in any letter case (index FeeStructure_schoolId_lower_name_key).
model FeeStructure {
  id           String       @id @default(uuid())
  schoolId     String
  name         String
  category     FeeCategory
  description  String?
  amountPaise  Int
  frequency    FeeFrequency
  dueDay       Int          @default(5) // 1-31; a short month uses its last day
  mandatory    Boolean      @default(true)
  programId    String?
  batchId      String?
  academicYear String // e.g. "2026-27"
  createdById  String?
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // NoAction: a school delete still cascades; deleting a program or batch
  // that a fee is scoped to is refused by those services.
  program Program? @relation(fields: [programId, schoolId], references: [id, schoolId], onDelete: NoAction)
  batch   Batch?   @relation(fields: [batchId, schoolId], references: [id, schoolId], onDelete: NoAction)
  dues    FeeDue[]

  @@unique([id, schoolId])
  @@index([schoolId])
}

// What one student owes for one fee and one period ("2026-10", "2026-Q4",
// "2026-27" or "ONCE"). netPaise = amount - discount + late fee, and paidPaise
// is the sum of its payments that aren't voided; both are kept in step by the
// API inside the same transaction, and CHECK constraints guard them.
model FeeDue {
  id             String     @id @default(uuid())
  schoolId       String
  studentId      String
  structureId    String
  period         String
  dueDate        DateTime   @db.Date
  amountPaise    Int
  discountPaise  Int        @default(0)
  lateFeePaise   Int        @default(0)
  netPaise       Int
  paidPaise      Int        @default(0)
  statusOverride FeeStatus?
  overrideReason String?
  overrideById   String?
  overrideAt     DateTime?  @db.Timestamptz(3)
  notes          String?
  createdById    String?
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // NoAction: dues are financial records; a student or fee with dues can't be
  // deleted (the services say why), but a school delete still cascades.
  student   Student      @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: NoAction)
  structure FeeStructure @relation(fields: [structureId, schoolId], references: [id, schoolId], onDelete: NoAction)
  payments  FeePayment[]

  @@unique([structureId, studentId, period])
  @@unique([id, schoolId])
  @@index([schoolId, dueDate])
  @@index([studentId])
}

// A payment the school received (recorded, never collected online). Payments
// are never edited or deleted: a mistake is voided, with who, when and why.
// Receipt numbers are unique per school; a transaction reference can't be
// reused by another live payment (partial index in the migration); a retried
// request with the same idempotency key returns the first payment.
model FeePayment {
  id             String        @id @default(uuid())
  schoolId       String
  dueId          String
  receiptNumber  String
  amountPaise    Int
  method         PaymentMethod
  transactionRef String?
  paidOn         DateTime      @db.Date
  source         PaymentSource @default(MANUAL)
  idempotencyKey String?
  notes          String?
  recordedById   String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  voidedAt       DateTime?     @db.Timestamptz(3)
  voidedById     String?
  voidReason     String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  due    FeeDue @relation(fields: [dueId, schoolId], references: [id, schoolId], onDelete: NoAction)

  @@unique([schoolId, receiptNumber])
  @@unique([schoolId, idempotencyKey])
  @@index([dueId])
  @@index([schoolId, paidOn])
}

// The last automatic receipt number per school and year (REC-2026-000001).
model FeeReceiptCounter {
  schoolId String
  year     Int
  last     Int    @default(0)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([schoolId, year])
}

enum MeetingType {
  GENERAL
  MANAGEMENT
  PARENT_TEACHER
  STAFF
  DISCIPLINARY
}

enum AgendaPriority {
  LOW
  MEDIUM
  HIGH
}

enum AgendaStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// A school meeting (PRD 4.14): the Meetings Log entry, with its agenda items
// as the minutes. The time is minutes after midnight, Indian time (optional).
model Meeting {
  id                String      @id @default(uuid())
  schoolId          String
  title             String
  type              MeetingType @default(GENERAL)
  date              DateTime    @db.Date
  startMinute       Int?
  venue             String?
  attendees         String[]    @default([])
  minutesPreparedBy String?
  nextMeetingDate   DateTime?   @db.Date
  createdById       String?
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)

  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  agendaItems MeetingAgendaItem[]

  @@unique([id, schoolId])
  @@index([schoolId, date])
}

// One agenda / discussion item of a meeting, with what was decided and who
// follows it up.
model MeetingAgendaItem {
  id             String         @id @default(uuid())
  schoolId       String
  meetingId      String
  title          String
  discussion     String?
  action         String?
  responsible    String?
  targetDate     DateTime?      @db.Date
  communicatedTo String?
  communicatedBy String?
  priority       AgendaPriority @default(MEDIUM)
  status         AgendaStatus   @default(NOT_STARTED)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([meetingId])
  @@index([schoolId])
}

enum CalendarEventType {
  HOLIDAY
  EXAM
  EVENT
  PARENT_MEETING
}

enum EventRepeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

// The Academic Calendar (PRD 4.15): holidays, exams, events and parent
// meetings. Dates are school-local calendar dates. A repeating event recurs
// from its start (until repeatUntil, or indefinitely); the API expands it
// into the dates being viewed. Scope: the whole school, one program or one
// batch (a scoped event goes when its program or batch is deleted).
model CalendarEvent {
  id          String            @id @default(uuid())
  schoolId    String
  title       String
  type        CalendarEventType
  programId   String?
  batchId     String?
  startDate   DateTime          @db.Date
  endDate     DateTime          @db.Date
  description String?
  repeat      EventRepeat       @default(NONE)
  repeatUntil DateTime?         @db.Date
  createdById String?
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId, schoolId], references: [id, schoolId], onDelete: Cascade)
  batch   Batch?   @relation(fields: [batchId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([schoolId, startDate])
  @@index([programId])
  @@index([batchId])
}

// A teacher's daily class report (PRD 4.8 and 5.6): what was taught to one
// batch on one day. It is On Time only when first submitted on that day in
// India; one sent later, or for an earlier day, is Late (the HLD's next-day
// rule). Reports are teaching records: a batch with reports can't be deleted
// (end it instead), and a report keeps its teacher's name if their profile goes.
model DailyReport {
  id           String    @id @default(uuid())
  schoolId     String
  facultyId    String? // the reporting teacher; null once their profile is deleted
  teacherName  String // as it was when submitted, so the record still names them
  batchId      String
  reportDate   DateTime  @db.Date // the day taught
  subject      String
  chapter      String?
  topics       String
  homework     String?
  observations String?
  late         Boolean // submitted after reportDate (IST); checked by the database
  submittedAt  DateTime  @db.Timestamptz(3) // first submission; edits don't change it
  editedAt     DateTime? @db.Timestamptz(3) // the teacher's last change to the content (not an admin flag)
  // Flagged by an admin for follow-up (PRD 4.8, HLD 9.5), with who, when and why; a CHECK keeps them together.
  flaggedAt    DateTime? @db.Timestamptz(3)
  flaggedBy    String?
  flaggedById  String?
  flagReason   String?
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // Tied to the report's school; deleting the profile nulls only facultyId (ON DELETE SET NULL ("facultyId")).
  faculty Faculty? @relation(fields: [facultyId, schoolId], references: [id, schoolId], onDelete: SetNull)
  batch   Batch    @relation(fields: [batchId, schoolId], references: [id, schoolId], onDelete: NoAction)

  @@index([schoolId, reportDate])
  @@index([facultyId, reportDate])
  @@index([batchId])
}

enum FeedbackDirection {
  TEACHER_TO_MANAGEMENT
  MANAGEMENT_TO_TEACHER
}

enum FeedbackCategory {
  ACADEMICS
  DISCIPLINE
  PUNCTUALITY
  TEACHING_QUALITY
  ADMINISTRATION
  GENERAL
}

// Submitted -> Reviewed -> Actioned, or Dismissed (archived), set by admins.
enum FeedbackStatus {
  SUBMITTED
  REVIEWED
  ACTIONED
  DISMISSED
}

enum FeedbackSource {
  APP
  IMPORT
}

// Feedback between management and faculty (PRD 4.12 and 5.13), both ways.
// A teacher sends to management; an admin sends to one teacher or to all
// faculty. Admins move every entry through the review workflow. Names are kept
// as they were when sent, so an entry still reads right if a profile goes.
model Feedback {
  id                String            @id @default(uuid())
  schoolId          String
  direction         FeedbackDirection
  senderName        String
  senderFacultyId   String? // a teacher sender's profile; null once it is deleted
  createdById       String? // the signed-in user who sent or imported it
  toAllFaculty      Boolean           @default(false) // Management -> Teacher, addressed to every teacher
  targetFacultyId   String? // Management -> Teacher, addressed to one teacher
  targetName        String? // that teacher's name when it was sent
  rating            Int // 1-5
  content           String
  subject           String?
  category          FeedbackCategory  @default(GENERAL)
  feedbackDate      DateTime          @db.Date // when it was given (an imported sheet can say an earlier day)
  status            FeedbackStatus    @default(SUBMITTED)
  statusChangedAt   DateTime?         @db.Timestamptz(3)
  statusChangedBy   String? // the admin who last moved it (their name then)
  statusChangedById String? // and their user id, which stays traceable if names repeat or change
  source            FeedbackSource    @default(APP)
  importKey         String? // imported rows: a hash of the sheet's cells as written, unique per school
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // Tied to the entry's school; deleting the profile nulls only that link (ON DELETE SET NULL (column) in the migration).
  senderFaculty Faculty? @relation("FeedbackSender", fields: [senderFacultyId, schoolId], references: [id, schoolId], onDelete: SetNull)
  targetFaculty Faculty? @relation("FeedbackTarget", fields: [targetFacultyId, schoolId], references: [id, schoolId], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([schoolId, status])
  @@index([senderFacultyId])
  @@index([targetFacultyId])
}

// Notes from a parent-teacher meeting (PRD 5.8): what was discussed about a
// student, what was agreed, and when to follow up. Faculty log and read their
// own; the notes feed the student's 5-in-1 report (HLD). The batch and the
// teacher are kept by name too, so a note still reads right after either goes.
model PtmNote {
  id             String    @id @default(uuid())
  schoolId       String
  studentId      String
  batchId        String? // the student's batch at the meeting; null once that batch is deleted
  batchName      String
  facultyId      String? // the teacher who logged it; null once their profile is deleted
  teacherName    String
  meetingDate    DateTime  @db.Date
  parentName     String?
  parentAttended Boolean
  discussion     String
  actionItems    String?
  followUpDate   DateTime? @db.Date
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  // Tied to the note's school. Deleting the batch or faculty profile nulls only that link
  // (ON DELETE SET NULL ("batchId") / ("facultyId") in the migration; Prisma warns about
  // SetNull with the required schoolId, which the column list makes safe).
  batch   Batch?   @relation(fields: [batchId, schoolId], references: [id, schoolId], onDelete: SetNull)
  faculty Faculty? @relation(fields: [facultyId, schoolId], references: [id, schoolId], onDelete: SetNull)

  @@index([schoolId, meetingDate])
  @@index([facultyId, meetingDate])
  @@index([studentId])
  @@index([batchId])
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MCQ
  NUMERICAL
  INTEGER
  SUBJECTIVE
}

enum TestType {
  UNIT_TEST
  MOCK
  DPP
}

// Stored state only: Ongoing and Completed follow from the clock.
enum TestStatus {
  SCHEDULED
  CANCELLED
}

// How one student did on one question of a paper.
enum AnswerOutcome {
  CORRECT
  PARTIAL // a subjective answer given some, not all, of its marks
  INCORRECT
  UNATTEMPTED
}

// The question bank (PRD 4.10, 5.11). Faculty keep their own questions; admins
// see and manage every question of the school. Tests copy questions into their
// paper (TestQuestion), so editing or deleting one here never rewrites a test.
model Question {
  id            String             @id @default(uuid())
  schoolId      String
  subject       String
  chapterId     String? // a curriculum chapter of the school; null once it is deleted
  chapterName   String? // as it was when picked
  topic         String // Concept / Topic
  difficulty    QuestionDifficulty
  type          QuestionType
  text          String
  options       String[]           @default([]) // A-D for an MCQ, empty otherwise
  correctAnswer String? // "A"-"D", a number, or a model answer (subjective)
  marks         Int
  negativeMarks Int                @default(0) // marks taken off for a wrong answer (0-9)
  source        String             @default("Custom")
  facultyId     String? // the teacher who added it; null for admins, or once the profile is deleted
  authorName    String // who added it, as they were named then
  createdById   String?
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)

  school  School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  chapter CurriculumChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  // School-tied: deleting the profile nulls only facultyId (ON DELETE SET NULL ("facultyId") in the migration).
  faculty Faculty?           @relation(fields: [facultyId, schoolId], references: [id, schoolId], onDelete: SetNull)
  papers  TestQuestion[]

  @@unique([id, schoolId])
  @@index([schoolId, subject])
  @@index([facultyId])
  @@index([chapterId])
}

// A test, administered outside the platform (HLD 9.6): scheduled by an admin
// or a teacher for one batch, with a paper of questions from the bank and
// results entered by staff.
model Test {
  id              String     @id @default(uuid())
  schoolId        String
  title           String
  type            TestType
  subject         String
  batchId         String
  startsAt        DateTime   @db.Timestamptz(3) // the date and time entered, in India
  durationMinutes Int
  endsAt          DateTime   @db.Timestamptz(3) // startsAt + durationMinutes (a CHECK keeps it so), for filtering by phase
  totalMarks      Int
  status          TestStatus @default(SCHEDULED)
  cancelledAt     DateTime?  @db.Timestamptz(3)
  facultyId       String? // the teacher who created it; null for admins, or once the profile is deleted
  createdByName   String
  createdById     String?
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // A batch with recorded results can't be deleted (the API refuses); one with
  // only scheduled tests takes them along.
  batch     Batch          @relation(fields: [batchId, schoolId], references: [id, schoolId], onDelete: Cascade)
  faculty   Faculty?       @relation(fields: [facultyId, schoolId], references: [id, schoolId], onDelete: SetNull)
  questions TestQuestion[]
  results   TestResult[]

  @@unique([id, schoolId])
  @@index([schoolId, startsAt])
  @@index([schoolId, endsAt])
  @@index([batchId, startsAt])
  @@index([facultyId])
}

// A question on a test's paper: a copy of it as it was when attached (HLD
// 8.3), so curriculum and bank edits never change a paper or its results.
model TestQuestion {
  id            String             @id @default(uuid())
  schoolId      String
  testId        String
  questionId    String? // the bank question it came from; null once that is deleted
  position      Int
  subject       String
  chapterName   String?
  topic         String
  difficulty    QuestionDifficulty
  type          QuestionType
  text          String
  options       String[]           @default([])
  correctAnswer String?
  marks         Int
  negativeMarks Int                @default(0)

  school   School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  test     Test         @relation(fields: [testId, schoolId], references: [id, schoolId], onDelete: Cascade)
  // School-tied: deleting the bank question nulls only questionId (ON DELETE SET NULL ("questionId")).
  question Question?    @relation(fields: [questionId, schoolId], references: [id, schoolId], onDelete: SetNull)
  answers  TestAnswer[]

  @@unique([id, schoolId])
  @@unique([id, testId, schoolId])
  @@unique([testId, position])
  @@index([questionId])
}

// One student's result on one test (HLD: unique per student and test, an
// explicit present/absent state, bounded counts). Ranks and percentiles are
// worked out when read, among the students who were present.
model TestResult {
  id          String   @id @default(uuid())
  schoolId    String
  testId      String
  studentId   String
  present     Boolean
  marks       Decimal? @db.Decimal(8, 2) // null when absent; can be negative with negative marking
  correct     Int?
  incorrect   Int?
  unattempted Int?
  remarks     String?
  gradedById  String?
  gradedBy    String // who entered it last, as they were named then
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  test    Test         @relation(fields: [testId, schoolId], references: [id, schoolId], onDelete: Cascade)
  // Results are records: a student with results can't be deleted (the API refuses).
  student Student      @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: NoAction)
  answers TestAnswer[]

  @@unique([id, schoolId])
  @@unique([id, testId, schoolId])
  @@unique([testId, studentId])
  @@index([studentId])
}

// How a student answered one question of the paper: what topic strength and
// mistake history are built from (HLD 9.6).
model TestAnswer {
  id             String        @id @default(uuid())
  schoolId       String
  testId         String // the result's test: an answer is tied to a result and a paper question of the same test
  resultId       String
  testQuestionId String
  response       String? // the option or value given (objective questions)
  outcome        AnswerOutcome
  marksAwarded   Decimal       @db.Decimal(6, 2)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  result       TestResult   @relation(fields: [resultId, testId, schoolId], references: [id, testId, schoolId], onDelete: Cascade)
  testQuestion TestQuestion @relation(fields: [testQuestionId, testId, schoolId], references: [id, testId, schoolId], onDelete: Cascade)

  @@unique([resultId, testQuestionId])
  @@index([testQuestionId])
}

// Student Reports (PRD 4.5, 4.8, 5.4, 5.7; HLD 9.7). The 5-in-1 report is
// worked out when read from the records each module keeps (tests and their
// answers, graded assignments, attendance, PTM notes); these tables hold what
// no other module collects.

// The terms a school reports marks for (PRD 4.8).
enum ReportTerm {
  UNIT_TEST_1
  TERM_1
  MID_TERM
  TERM_2
  ANNUAL
}

enum MarkSource {
  IMPORT // an uploaded sheet (Import student report)
  MANUAL // Generate / Edit Progress Report
}

// A teacher's rating of one student for one day (Student Ratings, PRD 5.7):
// four dimensions, each Unsatisfactory (1) to Excellent (5). One per student,
// day and teacher; the behaviour score averages every teacher's ratings.
model DailyRating {
  id          String   @id @default(uuid())
  schoolId    String
  studentId   String
  batchId     String? // the batch it was given in; null once that batch is deleted
  facultyId   String? // the rating teacher; null once their profile is deleted
  raterName   String // as they were named then
  date        DateTime @db.Date
  attitude    Int // 1-5, checked by the database
  behaviour   Int
  focus       Int
  interaction Int
  notes       String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  // School-tied; deleting the batch or profile nulls only that link (ON DELETE SET NULL ("batchId") / ("facultyId")).
  batch   Batch?   @relation(fields: [batchId, schoolId], references: [id, schoolId], onDelete: SetNull)
  faculty Faculty? @relation(fields: [facultyId, schoolId], references: [id, schoolId], onDelete: SetNull)

  @@unique([studentId, date, facultyId])
  @@index([schoolId, date])
  @@index([batchId, date])
  @@index([facultyId, date])
}

// One student's marks in one subject for one term of an academic year (an
// imported report sheet, or a progress report). The batch is the student's
// when entered: the cohort term ranks are worked out in.
model StudentMark {
  id           String     @id @default(uuid())
  schoolId     String
  studentId    String
  batchId      String
  academicYear Int // the year it starts, e.g. 2026 for 2026-27
  term         ReportTerm
  subject      String
  marks        Decimal    @db.Decimal(7, 2) // 0 to maxMarks, checked by the database
  maxMarks     Decimal    @db.Decimal(7, 2)
  attendance   Decimal?   @db.Decimal(5, 2) // percent, 0-100 (from the sheet)
  remarks      String?
  source       MarkSource
  enteredById  String?
  enteredBy    String // who entered it last, as they were named then
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // Marks are records: a student or batch with marks can't be deleted (the API
  // refuses); NoAction (checked at end of statement) lets a school delete cascade.
  student Student @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: NoAction)
  batch   Batch   @relation(fields: [batchId, schoolId], references: [id, schoolId], onDelete: NoAction)

  @@unique([studentId, academicYear, term, subject])
  @@index([schoolId, academicYear, term])
  @@index([batchId, academicYear, term])
}

// The remarks on one student's progress report for a term (PRD 4.8). The
// report's subjects are that term's StudentMark rows; rank and percentile are
// worked out when read, within the batch.
model ProgressReport {
  id               String     @id @default(uuid())
  schoolId         String
  studentId        String
  academicYear     Int
  term             ReportTerm
  teacherRemarks   String?
  principalRemarks String?
  updatedById      String?
  updatedBy        String // who generated or last edited it, as they were named then
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([studentId, academicYear, term])
  @@index([schoolId, academicYear, term])
}

// Account settings (PRD 3.x: profile picture, Account Preferences).

// A profile picture uploaded by the user: a small image (resized in the
// browser, at most 256 KB) kept with the account rather than in a school's
// file storage, as an account spans schools. Shown only to the user.
model UserAvatar {
  userId      String   @id
  contentType String // image/jpeg, image/png or image/webp (checked against the bytes)
  data        Bytes
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationKind {
  SYLLABUS_UPDATE // a chapter's syllabus status changed (Account Preferences: Syllabus Updates)
}

// An in-app notification (the bell) for one user about one school. Created
// only for users whose preferences ask for that kind; read while the user is
// still an active member of the school.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  schoolId  String
  kind      NotificationKind
  title     String
  body      String
  link      String? // a path in the user's portal
  readAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([schoolId])
}

// The daily report digest emailed to a user for one day (Account
// Preferences: Email Notifications): one row per user and day, so a digest is
// sent once however many API instances run the job.
model EmailDigest {
  userId String
  day    DateTime @db.Date // the IST day the digest covers
  sentAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}
