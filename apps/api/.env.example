# Neon pooled connection (host contains "-pooler") — used by the running app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/eduadmin?sslmode=verify-full"
# Neon direct connection — used by Prisma CLI for migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/eduadmin?sslmode=verify-full"

# Admins verify email when true. Always on in production (false is refused at boot).
REQUIRE_EMAIL_VERIFICATION=false

PORT=3000
WEB_ORIGIN="http://localhost:5173"
# Number of reverse proxies / load balancers in front of the API (0 = none).
TRUST_PROXY=0

# Email (Gmail: create an App Password at https://myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="academicplanningsystem@gmail.com"
SMTP_PASS=""
MAIL_FROM="Academic Planning System <academicplanningsystem@gmail.com>"

# File uploads (student photos; later study material). Cloudflare R2: set all
# four, or none. With none, development stores files in apps/api/.storage and
# production switches uploads off. The bucket must allow PUT and GET from
# WEB_ORIGIN (CORS); see docs/deploy.md.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
